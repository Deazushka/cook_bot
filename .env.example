# Environment variables for Cooking Bot (Koyeb/Deployment)
# Create a .env file based on this template

# Telegram Bot Token (get from @BotFather) - REQUIRED
BOT_TOKEN=your_telegram_bot_token_here

# Data directory for SQLite database (used by Docker/Koyeb persistent disk)
DATA_DIR=data

# Optional: override the default SQLite path.
# DATABASE_URL=/app/data/cooking_bot.db

# Optional: Admin user IDs (comma-separated)
ADMIN_USER_IDS=123456789
